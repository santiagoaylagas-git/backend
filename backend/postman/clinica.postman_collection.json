{
  "info": {
    "name": "Clinica - Backend Semana 1",
    "description": "Setup, conexión a la base y autenticación (health, registro, login, perfil, coberturas)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3000" },
    { "key": "token", "value": "" },
    { "key": "token_admin", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
      }
    },
    {
      "name": "Coberturas - listar",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/coberturas", "host": ["{{base_url}}"], "path": ["coberturas"] }
      }
    },
    {
      "name": "Auth - Registro",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 201', function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Test\",\n  \"apellido\": \"Postman\",\n  \"dni\": \"30111222\",\n  \"email\": \"test.postman@clinica.com\",\n  \"password\": \"secreto123\",\n  \"fecha_nacimiento\": \"1999-01-01\",\n  \"id_cobertura\": 1\n}"
        },
        "url": { "raw": "{{base_url}}/auth/registro", "host": ["{{base_url}}"], "path": ["auth", "registro"] }
      }
    },
    {
      "name": "Auth - Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.datos && jsonData.datos.token) {",
              "  pm.collectionVariables.set('token', jsonData.datos.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"30111222\",\n  \"password\": \"secreto123\"\n}"
        },
        "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "Auth - Perfil (protegido)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/auth/perfil", "host": ["{{base_url}}"], "path": ["auth", "perfil"] }
      }
    },
    {
      "name": "Auth - Perfil sin token (401 esperado)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/auth/perfil", "host": ["{{base_url}}"], "path": ["auth", "perfil"] }
      }
    },
    {
      "name": "Auth - Login admin (usuario de prueba del script)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });",
              "var jsonData = pm.response.json();",
              "if (jsonData && jsonData.datos && jsonData.datos.token) {",
              "  pm.collectionVariables.set('token_admin', jsonData.datos.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dni\": \"18222333\",\n  \"password\": \"test1234\"\n}"
        },
        "url": { "raw": "{{base_url}}/auth/login", "host": ["{{base_url}}"], "path": ["auth", "login"] }
      }
    },
    {
      "name": "Auth - Panel admin con rol admin (200 esperado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token_admin}}" }],
        "url": { "raw": "{{base_url}}/auth/panel-admin", "host": ["{{base_url}}"], "path": ["auth", "panel-admin"] }
      }
    },
    {
      "name": "Auth - Panel admin con rol paciente (403 esperado)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 403', function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": { "raw": "{{base_url}}/auth/panel-admin", "host": ["{{base_url}}"], "path": ["auth", "panel-admin"] }
      }
    },
    {
      "name": "Auth - Panel admin sin token (401 esperado)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{base_url}}/auth/panel-admin", "host": ["{{base_url}}"], "path": ["auth", "panel-admin"] }
      }
    }
  ]
}
