{
  // Tareas: Terminal > Ejecutar tarea... (Terminal > Run Task...)
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: instalar dependencias",
      "type": "shell",
      "command": "npm install",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: importar base de datos (desde cero)",
      "type": "shell",
      "command": "npm run db:importar",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Backend: levantar API (npm run dev)",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
