{
  // Ejecutar y depurar (F5): levanta la API con el depurador conectado.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend: depurar API",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/src/server.js",
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
